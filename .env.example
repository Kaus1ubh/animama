# Non-secret reference settings; select only needed values for each ignored .env.
# Select sources explicitly (run from the checkout root):
# export COMPOSE_ENV_FILES="$HOME/.config/animama/dev-secrets.env,$PWD/.env"
# Shared credentials: owner-only external file. Shell overrides files; later files
# override earlier ones. Do not copy another checkout's complete .env.
# See docs/backend/operations/development.md for setup, drift checks and resumption.

ANIMAMA_LOG_DIR=.animama-logs

# PostgreSQL Configuration (compose defaults)
POSTGRES_USER=animama
# POSTGRES_PASSWORD belongs in the external credential file when overridden.
POSTGRES_DB=animama

# Optional local operator tools: ./reset.sh --profile dev-tools
# Or set COMPOSE_PROFILES=dev-tools here. Disabled by default; never publish
# these tools through a public tunnel/proxy or include them in desktop bundles.
# Bind addresses are fixed at 127.0.0.1. --base-port B derives B+4 and B+20.
PGADMIN_PORT=5050
DOZZLE_PORT=9999
# Infrastructure credentials, not Animama accounts.
PGADMIN_EMAIL=admin@animama.com
# PGADMIN_PASSWORD belongs in the external credential file when overridden.

# The selected application service alone publishes this loopback port.
# Explicit dev-tools adds only the two local operator ports above.
WEB_SERVER_PORT=8000

# development: Vite with HMR proxies application routes to private FastAPI.
# production: FastAPI serves the React build baked into the application image.
# reset.sh selects the Compose graph and records it in .animama-stack.env.
# This selects build/serving behavior, not authentication. Switching preserves data.
ANIMAMA_WEB_BUILD_MODE=development
# Development reload, Vite and the Local content watcher use native file events.
# Leave empty, or set true only when the host does not deliver bind-mount file
# events to containers.
ANIMAMA_FILE_WATCH_POLLING=
# Application inspectors are opt-in during development only. Every production
# build (including embedded-desktop) excludes them even if this is true.
# Browser DevTools and the separate dev-tools profile are unaffected.
VITE_ENABLE_DEBUG_PANEL=false

# One application origin. PostgreSQL and supporting services stay private.
# dev-tools ports remain separate from the application origin.
ANIMAMA_PUBLIC_ORIGIN=http://localhost:8000
ANIMAMA_DESKTOP_WEB_URL=http://localhost:8000

# Supported native launchers bind only to loopback and reject broader values.
# Compose uses separate container-network-only entrypoints and ignores this.
ANIMAMA_LOCAL_BIND_HOST=127.0.0.1
ANIMAMA_LOCAL_API_PORT=8000
# Native source serving requires an explicit audited/built React directory:
# ANIMAMA_WEB_ROOT=./src/frontend/web/dist

# Native-development database URL. Compose replaces this with the private
# postgres service URL; PostgreSQL is not host-published by the default stack.
ANIMAMA_DATABASE_URL=postgresql+asyncpg://animama:a@localhost:5432/animama
ANIMAMA_DATABASE_POOL_SIZE=10
ANIMAMA_DATABASE_MAX_OVERFLOW=20
ANIMAMA_DATABASE_POOL_TIMEOUT_SECONDS=30
ANIMAMA_DATABASE_POOL_RECYCLE_SECONDS=-1
ANIMAMA_DATABASE_POOL_PRE_PING=true

# Canonical self-hosted storage. content/ is the readable Included/Local typed
# library; data/ holds private files, staging, operation receipts, derivatives,
# and internal runtime state. These host defaults are overridden with container
# paths by Docker Compose.
ANIMAMA_CONTENT_ROOT=./content
ANIMAMA_DATA_ROOT=./data

# Host bind sources used by Compose. reset.sh derives isolated values for named
# stacks and writes them to .animama-stack.env.
ANIMAMA_INCLUDED_CONTENT_HOST_PATH=./content/included
ANIMAMA_LOCAL_CONTENT_HOST_PATH=./content/local
ANIMAMA_DATA_HOST_PATH=./data
ANIMAMA_DOCLING_CACHE_HOST_PATH=./cache/docling

# Uploaded files. The server reads, chunks and (with an embeddings model)
# embeds each upload itself, one at a time; false keeps uploads but refuses to
# process them. Each file is read in a child process that is stopped past the
# time or memory limit, and a file larger than the processing size fails.
ANIMAMA_USER_FILE_PROCESSING_ENABLED=true
ANIMAMA_USER_FILE_MAX_PROCESS_BYTES=10485760
ANIMAMA_USER_FILE_PARSE_TIMEOUT_SECONDS=120
ANIMAMA_USER_FILE_PARSE_MEMORY_MB=1024
# Seconds between checks for queued files, seconds a stopped server's claim on
# a file lasts before the file is processed again, and attempts before a file
# that keeps failing for an unexpected reason fails for good.
ANIMAMA_USER_FILE_PROCESSING_POLL_SECONDS=2
ANIMAMA_USER_FILE_PROCESSING_LEASE_SECONDS=300
ANIMAMA_USER_FILE_PROCESSING_MAX_ATTEMPTS=3

# Capability policy for source/self-hosted development.
# ANIMAMA_PARAKEET_STT_ENABLED=false turns offline English speech recognition
# off, and ANIMAMA_SENSEVOICE_STT_ENABLED=false offline Japanese, Korean and
# Chinese recognition, even when their models are installed.
ANIMAMA_PARAKEET_STT_ENABLED=true
ANIMAMA_SENSEVOICE_STT_ENABLED=true
# ANIMAMA_PARAKEET_SOURCE selects where both speech-to-text engines' sets come
# from. Each Compose file fixes it (asset-store for built, operator for
# development, where Vite serves the host sets reset.sh mounts); a value here
# has no effect under Compose. Native launches default to asset-store.

# OpenAI API Configuration
# OPENAI_API_KEY belongs in ~/.config/animama/dev-secrets.env, never this file.
# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY (the built-in Anthropic connection) also belongs in
# ~/.config/animama/dev-secrets.env, never this file.
# Default chat model (catalog row id) for newly created Animas.
ANIMAMA_DEFAULT_MODEL_PROVIDER_ID=OpenAIResponsesHTTPAgent:gpt-6-luna
# Optional operator defaults for the other model roles; App Settings choices
# take precedence. Utility (titles, compaction) and the Memory Manager use the
# default chat model when unset; embeddings stay off until a model is chosen.
# ANIMAMA_DEFAULT_UTILITY_MODEL_PROVIDER_ID=OpenAIHTTPAgent:gpt-6-luna
# ANIMAMA_DEFAULT_MEMORY_MANAGER_MODEL_PROVIDER_ID=
# ANIMAMA_DEFAULT_EMBEDDING_MODEL_PROVIDER_ID=OpenAIHTTPAgent:text-embedding-3-small
# Host that the Ollama, LM Studio, llama.cpp and vLLM presets use for model
# servers on this machine; Compose defaults to host.docker.internal.
# ANIMAMA_LOCAL_MODEL_HOST=host.docker.internal
# Keys for owner-added model connections: an absolute path to an owner-only
# (chmod 600) file outside the checkout, holding ANIMAMA_CONNECTION_<NAME>_API_KEY
# lines. See docs/backend/operations/local-models.md.
# ANIMAMA_CONNECTION_KEYS_FILE=/home/you/.config/animama/connection-keys.env
ANIMAMA_CHAT_TITLE_GENERATION_REASONING_EFFORT=none

NODE_ENV=development

# Optional absolute shared model STORE root (not the resolved version directory).
# Default: ~/Library/Caches/Animama/models on macOS; XDG cache/animama/models on Linux/WSL.
# Native Windows: %LOCALAPPDATA%\Animama\models (ANIMAMA_MODEL_ROOT still overrides).
# Acquire the sets explicitly before reset: scripts/models/{parakeet,browser_speech}.py acquire,
# and scripts/models/sensevoice.py acquire for Japanese, Korean and Chinese.
# ANIMAMA_MODEL_ROOT=/var/lib/animama/models

# Companion safety (operator settings; see docs/safety/crisis-protocol.md).
# The global switch turns the AI notice, crisis detection (including OpenAI
# Responses moderation) and the crisis card off together. Relaxing these is the operator's responsibility.
# ANIMAMA_COMPANION_SAFETY_ENABLED=true
# ANIMAMA_AI_NOTICE_ENABLED=true
# ANIMAMA_AI_NOTICE_REMINDER_HOURS=3
# ANIMAMA_CRISIS_DETECTION_ENABLED=true
# ANIMAMA_CRISIS_RESOURCES_PATH=
