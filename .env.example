ANIMAMA_LOG_DIR=.animama-logs

# PostgreSQL Configuration (compose defaults)
POSTGRES_USER=animama
POSTGRES_PASSWORD=a
POSTGRES_DB=animama

# Optional local operator tools: ./reset.sh --profile dev-tools
# Or set COMPOSE_PROFILES=dev-tools here. Disabled by default; never publish
# these tools through a public tunnel/proxy or include them in desktop bundles.
# Bind addresses are fixed at 127.0.0.1. --base-port B derives B+4 and B+20.
PGADMIN_PORT=5050
DOZZLE_PORT=9999
# Infrastructure credentials, not Animama accounts.
PGADMIN_EMAIL=admin@animama.com
PGADMIN_PASSWORD=a

# The selected application service alone publishes this loopback port.
# Explicit dev-tools adds only the two local operator ports above.
WEB_SERVER_PORT=8000

# development: Vite with HMR proxies application routes to private FastAPI.
# production: FastAPI serves the React build baked into the application image.
# reset.sh selects the Compose graph and records it in .animama-stack.env.
# This selects build/serving behavior, not authentication. Switching preserves data.
ANIMAMA_WEB_BUILD_MODE=development
# Application inspectors are opt-in during development only. Every production
# build (including embedded-desktop) excludes them even if this is true.
# Browser DevTools and the separate dev-tools profile are unaffected.
VITE_ENABLE_DEBUG_PANEL=false

# One application origin. PostgreSQL and supporting services stay private.
# dev-tools ports remain separate from the application origin.
ANIMAMA_PUBLIC_ORIGIN=http://localhost:8000
ANIMAMA_DESKTOP_WEB_URL=http://localhost:8000

# Supported native launchers bind only to loopback and reject broader values.
# Compose uses separate container-network-only entrypoints and ignores this.
ANIMAMA_LOCAL_BIND_HOST=127.0.0.1
ANIMAMA_LOCAL_API_PORT=8000
# Native source serving requires an explicit audited/built React directory:
# ANIMAMA_WEB_ROOT=./src/frontend/web/dist

# Native-development database URL. Compose replaces this with the private
# postgres service URL; PostgreSQL is not host-published by the default stack.
ANIMAMA_DATABASE_URL=postgresql+asyncpg://animama:a@localhost:5432/animama
ANIMAMA_DATABASE_POOL_SIZE=10
ANIMAMA_DATABASE_MAX_OVERFLOW=20
ANIMAMA_DATABASE_POOL_TIMEOUT_SECONDS=30
ANIMAMA_DATABASE_POOL_RECYCLE_SECONDS=-1
ANIMAMA_DATABASE_POOL_PRE_PING=true

# Canonical self-hosted storage. content/ is the readable Included/Local typed
# library; data/ holds private files, staging, operation receipts, derivatives,
# and internal runtime state. These host defaults are overridden with container
# paths by Docker Compose.
ANIMAMA_CONTENT_ROOT=./content
ANIMAMA_DATA_ROOT=./data

# Host bind sources used by Compose. reset.sh derives isolated values for named
# stacks and writes them to .animama-stack.env.
ANIMAMA_INCLUDED_CONTENT_HOST_PATH=./content/included
ANIMAMA_LOCAL_CONTENT_HOST_PATH=./content/local
ANIMAMA_DATA_HOST_PATH=./data
ANIMAMA_DOCLING_CACHE_HOST_PATH=./cache/docling

# Capability policy for source/self-hosted development. Enabling processing
# permits durable queueing but does not start the currently commented worker.
# Embedded desktop derives these from verified packs instead of this file.
ANIMAMA_USER_FILE_PROCESSING_ENABLED=true
ANIMAMA_PARAKEET_STT_ENABLED=true

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default Responses API model for newly created Animas.
ANIMAMA_DEFAULT_MODEL_PROVIDER_ID=OpenAIResponsesHTTPAgent:gpt-5.6-luna
ANIMAMA_MEMORY_MANAGER_AGENT_MODEL=gpt-5.4-mini

NODE_ENV=development
