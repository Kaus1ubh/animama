{
  "uid": "anima-system",
  "title": "Anima Process & Host",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "Process CPU %",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_cpu_percent",
          "legendFormat": "cpu%"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Process Memory RSS (bytes)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_memory_rss",
          "legendFormat": "rss"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Process Threads",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_threads",
          "legendFormat": "threads"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "System CPU Utilization",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (state) (system_cpu_utilization)",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "System Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (state) (system_memory_usage)",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "System Network IO (bytes/sec)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (direction) (rate(system_network_io_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
    }
  ]
}
