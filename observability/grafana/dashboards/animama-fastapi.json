{
  "uid": "anima-fastapi",
  "title": "Anima FastAPI (Detailed)",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 28,
      "type": "stat",
      "title": "Total HTTP Requests",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(animama_http_requests_total[$__range]))",
          "legendFormat": "total",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      }
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Active WebSocket Connections",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ws_server_active_connections)",
          "legendFormat": "active",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      }
    },
    {
      "id": 30,
      "type": "barchart",
      "title": "HTTP Requests by Route (count)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_route) (increase(animama_http_requests_total[$__range]))",
          "legendFormat": "{{http_route}}",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 31,
      "type": "heatmap",
      "title": "HTTP Duration Heatmap by Route",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (le) (rate(animama_http_duration_milliseconds_bucket{http_route=~\"$http_route\"}[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Top 5 Slowest Routes (p95)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, http_route) (rate(animama_http_duration_milliseconds_bucket[5m]))))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "/metrics scrape up",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Requests / sec by route",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_route) (rate(animama_http_requests_total[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Errors / sec by route",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_route) (rate(animama_http_errors_total[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Error rate by route (%)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (sum by (http_route) (rate(animama_http_errors_total[5m])) / sum by (http_route) (rate(animama_http_requests_total[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Latency p95 by route (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(animama_http_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Latency p50/p95/p99 (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(animama_http_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(animama_http_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(animama_http_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Active requests by route",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_route) (animama_http_active_requests)",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Requests / sec by status",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_status_code) (rate(animama_http_requests_total[5m]))",
          "legendFormat": "{{http_status_code}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Requests / sec by method",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (http_method) (rate(animama_http_requests_total[5m]))",
          "legendFormat": "{{http_method}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "http_route",
        "label": "HTTP Route",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(animama_http_requests_total, http_route)",
        "query": "label_values(animama_http_requests_total, http_route)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      }
    ]
  }
}