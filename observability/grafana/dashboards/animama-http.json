{
  "uid": "anima-http",
  "title": "Anima HTTP & WebSockets",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Requests / sec",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(animama_http_requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Errors / sec",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(animama_http_errors_total[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP P95 Latency (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(animama_http_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Active Requests",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(animama_http_active_requests)",
          "legendFormat": "active"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WebSocket Active Connections",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ws_server_active_connections)",
          "legendFormat": "active"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WebSocket Messages / sec",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ws_server_messages_total[5m]))",
          "legendFormat": "msgs/s"
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
    }
  ]
}
