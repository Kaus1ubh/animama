{
  "schema_version": 1,
  "content_type": "avatar_effect",
  "content_id": "builtin:avatar-effect:gloom_lines",
  "version": 1,
  "name": "Gloom Lines",
  "description": "Dark blue-purple vertical gloom lines that slide down over the brow like a curtain, for deflated, disappointed or remorseful moments.",
  "dependencies": [
    {
      "ref": "builtin:sound-effect:shrink_03",
      "content_type": "sound_effect",
      "alias": "on-apply",
      "optional": true
    }
  ],
  "definition": {
    "schema": "animama/avatar-effect/2",
    "region": "emote",
    "attachment": {
      "kind": "face_landmark",
      "landmark": "forehead",
      "offset": {
        "x": 0,
        "y": -0.025,
        "z": 0
      },
      "position": "middle",
      "scale": {
        "x": 1.1,
        "y": 0.95
      }
    },
    "art": {
      "image": "gloom_lines-draw-on.png",
      "flipbook": {
        "columns": 3,
        "fps": 12,
        "frames": 6,
        "loop": "once",
        "rows": 2
      }
    },
    "motion": {
      "keyframes": {
        "frames": [
          {
            "offset": {
              "x": 0,
              "y": 0.03
            },
            "opacity": 0,
            "t": 0
          },
          {
            "opacity": 1,
            "t": 0.15
          },
          {
            "offset": {
              "x": 0,
              "y": 0
            },
            "opacity": 1,
            "t": 0.5
          }
        ]
      }
    },
    "soundAlias": "on-apply"
  },
  "files": [
    {
      "path": "gloom_lines-draw-on.png",
      "role": "image"
    }
  ]
}
