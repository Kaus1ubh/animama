{
  "name": "animama-frontend-server",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./gateway": "./src/gateway/lifecycle.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:compose": "tsx watch src/compose-index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:compose": "node dist/compose-index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:accountless": "tsx scripts/smoke-accountless-gateway.ts",
    "verify:accountless": "tsx scripts/verify-accountless-journey.ts",
    "prettier": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --write 'src/**/*.{ts,tsx,js,jsx,json,md}' 'scripts/**/*.{ts,tsx,js,jsx,json,md}' '*.{js,mjs,ts,json,md}'",
    "prettier:check": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --check 'src/**/*.{ts,tsx,js,jsx,json,md}' 'scripts/**/*.{ts,tsx,js,jsx,json,md}' '*.{js,mjs,ts,json,md}'"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@hono/node-server": "^1.19.8",
    "hono": "^4.11.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/pg": "^8.16.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
