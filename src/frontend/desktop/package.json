{
  "name": "animama-desktop",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Animama private desktop runtime",
  "author": "Animama",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "dev": "pnpm build && electron .",
    "dev_inspect": "pnpm build && electron --inspect=9229 .",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm clean && pnpm check && node scripts/build.mjs",
    "pack": "pnpm pack:mac",
    "dist": "pnpm dist:mac",
    "dist:linux": "pnpm build && electron-builder --linux AppImage",
    "pack:mac": "pnpm build && node scripts/runtime/package-development.mjs",
    "build:mac": "pnpm runtime:stage -- --platform darwin --arch arm64 && pnpm runtime:audit -- --platform darwin --arch arm64 && pnpm pack:mac",
    "build:mac:run": "pnpm build:mac && pnpm launch:mac",
    "launch:mac": "open release/mac/Animama.app",
    "pack:mac:run": "pnpm pack:mac && pnpm launch:mac",
    "run:mac": "pnpm pack:mac:run",
    "dist:mac": "node scripts/runtime/release-gate.mjs mac",
    "pack:win": "pnpm build && electron-builder --win dir --x64",
    "run:win": "pnpm pack:win && node scripts/run-windows-app.mjs",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "prettier": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --write 'src/**/*.{ts,cts,tsx,js,jsx,json,md}' 'scripts/**/*.{js,mjs,ts,cts}' '*.{js,mjs,ts,json,md,yml,yaml}' 'runtime/**/*.json' 'tests/**/*.{ts,mjs}'",
    "prettier:check": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --check 'src/**/*.{ts,cts,tsx,js,jsx,json,md}' 'scripts/**/*.{js,mjs,ts,cts}' '*.{js,mjs,ts,json,md,yml,yaml}' 'runtime/**/*.json' 'tests/**/*.{ts,mjs}'",
    "test": "vitest run",
    "runtime:stage": "node scripts/runtime/stage.mjs",
    "runtime:audit": "node scripts/runtime/audit.mjs",
    "runtime:packs": "node scripts/runtime/feature-packs.mjs",
    "runtime:document-worker": "node scripts/runtime/document-worker.mjs",
    "release:mac": "node scripts/runtime/release-gate.mjs mac",
    "release:windows": "node scripts/runtime/release-gate.mjs windows",
    "smoke:mac": "node scripts/runtime/release-gate.mjs smoke-mac",
    "smoke:windows": "node scripts/runtime/release-gate.mjs smoke-windows"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "electron-updater": "6.8.9",
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/tar-stream": "3.1.4",
    "electron": "39.8.9",
    "electron-builder": "^26.0.12",
    "esbuild": "0.27.7",
    "node-gyp": "12.3.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.7"
  }
}
