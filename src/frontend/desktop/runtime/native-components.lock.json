{
  "schema": "animama-native-components/1",
  "target": "darwin-arm64",
  "minimum_os": "15.0",
  "postgresql": {
    "version": "16.15",
    "url": "https://ftp.postgresql.org/pub/source/v16.15/postgresql-16.15.tar.bz2",
    "sha256": "c1575341fa7bd40f5274ea465b34390f4dc64cdd0770af327005caaeb9f6b7ed",
    "checksum_url": "https://ftp.postgresql.org/pub/source/v16.15/postgresql-16.15.tar.bz2.sha256",
    "license": "PostgreSQL",
    "license_file": "COPYRIGHT",
    "configure": [
      "--without-icu",
      "--without-readline",
      "--without-zlib",
      "--without-gssapi",
      "--disable-nls"
    ],
    "cflags": "-O2 -g -arch arm64 -mmacosx-version-min=15.0"
  },
  "pgvector": {
    "version": "0.8.6",
    "url": "https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.6.tar.gz",
    "sha256": "10bf9938906e5d643bbc4a7eea104b6f57ba4898e5b76b20e60484ea1d5a7f8f",
    "license": "PostgreSQL",
    "license_file": "LICENSE",
    "make": [
      "OPTFLAGS=",
      "CFLAGS=-O2 -g -arch arm64 -mmacosx-version-min=15.0 -fno-strict-aliasing -fwrapv"
    ]
  },
  "executables": [
    "initdb",
    "pg_ctl",
    "pg_dump",
    "pg_isready",
    "pg_restore",
    "postgres"
  ],
  "extensions": ["pg_trgm", "vector"]
}
