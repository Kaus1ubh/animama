{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animama.invalid/schemas/feature-pack/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "display_name",
    "version",
    "app_versions",
    "platform",
    "architecture",
    "url",
    "archive_bytes",
    "archive_sha256",
    "installed_bytes",
    "minimum_peak_free_bytes",
    "license_refs",
    "files",
    "signing"
  ],
  "properties": {
    "schema": {
      "const": "animama-feature-pack/1"
    },
    "id": {
      "enum": ["expanded-included-content"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "app_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "platform": {
      "enum": ["darwin", "win32", "data-only"]
    },
    "architecture": {
      "enum": ["arm64", "x64", "data-only"]
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^/?#@:]+(/[^/?#]+)+\\.tar\\.zst$",
      "description": "A release folder of the distribution sealed in the app's update policy: an R2 <base_url>/v<version>/ folder or the configured GitHub repository's release download path."
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "installed_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_peak_free_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "license_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "signing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher", "requirement"],
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "requirement": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "media_type", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["0644", "0755"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "data-only"
          }
        }
      },
      "then": {
        "properties": {
          "architecture": {
            "const": "data-only"
          },
          "signing": {
            "type": "null"
          }
        }
      }
    }
  ]
}
