src/letta/

# The production image builds React once; only its static output crosses into
# Python. Keep desktop/native assets and installed dependencies out of context.
src/legacy/
src/frontend/**
!src/frontend/
!src/frontend/package.json
!src/frontend/pnpm-lock.yaml
!src/frontend/pnpm-workspace.yaml
!src/frontend/patches/
!src/frontend/patches/**
!src/frontend/prettier.config.mjs
!src/frontend/scripts/
!src/frontend/scripts/**
!src/frontend/shared/
!src/frontend/shared/**
!src/frontend/packages/
!src/frontend/packages/**
# The web build reports the desktop release version (web/vite-plugins/app-version.ts).
!src/frontend/desktop/package.json
!src/frontend/web/
!src/frontend/web/**
**/node_modules/**
**/dist/**
# The hosted build output also copies the browser speech models (about 280 MB);
# the image builds only web/dist, with models from the browser_models context.
**/dist-hosted/**
**/*.tsbuildinfo
cloud/
parakeet-tdt-0.6b-v2/

